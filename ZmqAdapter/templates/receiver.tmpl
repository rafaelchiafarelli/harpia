class {name}_{role} {{
public:
    // Trailing curve keys default to disabled (empty), so callers who don't
    // pass any get today's plaintext behavior unchanged.
    {name}_{role}(::zmq::context_t& ctx, const std::string& endpoint,
                  {curve_type} curve = {curve_type}())
        : socket_(ctx, ::zmq::socket_type::{sock}) {{
{curve_apply}        {setup}
    }}
    bool {verb}({cls}* msg) {{
        ::zmq::message_t frame;
        if (!socket_.recv(frame, ::zmq::recv_flags::none).has_value()) return false;
        return msg->ParseFromArray(frame.data(), static_cast<int>(frame.size()));
    }}
    ::zmq::socket_t& socket() {{ return socket_; }}
private:
    ::zmq::socket_t socket_;
}};

