// Generated by harpia (sessions J.2/J.3, thread-1-java-target). Do not edit.
//
// protoc/protoc-gen-grpc-java are NOT invoked by harpia itself -- per the
// codegen-timing decision (initiatives/multi-language-targets/
// thread-1-java-target/histories/gRPC-wiring/codegen-timing-decision.md),
// this build resolves and runs them itself via protobuf-gradle-plugin, the
// first time this project is built.
plugins {
    id 'java'
    id 'com.google.protobuf' version '0.9.4'
}

group = 'com.harpia.generated'
version = '1.0'

repositories {
    mavenCentral()
}

dependencies {
    implementation 'com.google.protobuf:protobuf-java:3.25.3'
    // JsonFormat (J.4) -- keep in lockstep with protobuf-java above.
    implementation 'com.google.protobuf:protobuf-java-util:3.25.3'

    // gRPC stub generation (J.3) -- runtime + codegen support for the
    // generated `<name>_ServiceGrpc` stub classes.
    implementation 'io.grpc:grpc-protobuf:1.62.2'
    implementation 'io.grpc:grpc-stub:1.62.2'
    implementation 'io.grpc:grpc-netty-shaded:1.62.2'
    // Generated stub classes reference javax.annotation.Generated, which
    // isn't on the JDK's own classpath from Java 9 onward.
    compileOnly 'org.apache.tomcat:annotations-api:6.0.53'

    // DB/CRUDL (J.5) -- pure JDBC, bundles native SQLite per-platform
    // transparently (no source-vendoring needed, unlike C++'s vendored
    // sqlite3).
    implementation 'org.xerial:sqlite-jdbc:3.45.1.0'
    // DB/CRUDL, Postgres dialect (J.8) -- pure Java, no native library at
    // all (unlike C++'s libpq). JavaCrudlAdapter's generated DAOs are
    // already dialect-neutral (take a plain java.sql.Connection), so this
    // is the entire J.8 wiring -- same DbBackend seam as SQLite (J.5).
    implementation 'org.postgresql:postgresql:42.7.3'
}

// protobuf-gradle-plugin's default proto source set (src/main/proto,
// scanned recursively) already covers src/main/proto/protofiles -- no
// explicit sourceSets block needed.
protobuf {
    protoc {
        // Keep this in lockstep with the protobuf-java version above --
        // the compiler and runtime must agree.
        artifact = 'com.google.protobuf:protoc:3.25.3'
    }
    plugins {
        grpc {
            // Keep this in lockstep with the io.grpc:* runtime versions
            // above -- the plugin and runtime must agree.
            artifact = 'io.grpc:protoc-gen-grpc-java:1.62.2'
        }
    }
    generateProtoTasks {
        // Every .proto under the source set gets a gRPC stub, even the
        // plain message files copied in by J.2 -- harmless (protoc/the grpc
        // plugin emit nothing for a file with no `service` block), and
        // simpler than partitioning the source set by file name.
        all()*.plugins { grpc {} }
    }
}

// A resolved runtime classpath, one line, no version-guessing -- used by
// this repo's own gradle+JDK-gated integration tests (tests/test_java_*.py)
// instead of hand-globbing exact jar paths out of the Gradle dependency
// cache (which breaks the moment a pinned version above changes, or a new
// transitive dependency enters the graph). Generically useful to any
// consumer running a generated class ad hoc, too.
tasks.register('harpiaRuntimeClasspath') {
    doLast {
        println('HARPIA_RUNTIME_CLASSPATH=' + sourceSets.main.runtimeClasspath.asPath)
    }
}
