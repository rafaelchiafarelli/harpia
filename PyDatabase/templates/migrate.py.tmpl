"""Schema migration for ``{name}`` (table ``{table}``) to version ``{hash}``.

Generated by harpia (python target), the port of the C++
``migrate_{name}``. Do not edit. Steps and their order are documented in
``harpia_runtime.db.migrate``; every SQL statement comes from the
``{dialect}`` ``DbBackend`` the C++ migration uses.
"""
from collections.abc import Callable

from harpia_generated.db.{name}_{hash}_dao import (
    {name}_dao,
)
from harpia_runtime.db.dao import Connection
from harpia_runtime.db.migrate import MigrationSpec, migrate

#: the schema version this migration targets
VERSION = {hash_lit}

SPEC = MigrationSpec(
    table={table_lit},
    version=VERSION,
    version_table_sql={version_table_sql},
    list_child_tables_sql={list_child_tables_sql},
    child_renames={child_renames},
    list_columns_sql={list_columns_sql},
    renames={renames},
    adds={adds},
    current_columns={current_columns},
    drop_column_sql={drop_column_sql},
    retype={retype},
    child_current={child_current},
    drop_table_sql={drop_table_sql},
    child_plans={child_plans},
    stamp_sql={stamp_sql},
)


def migrate_{name}(conn: Connection,
{pad}data_transform: Callable[[Connection], None] | None = None) -> bool:
    """Bring an existing database's ``{table}`` up to version ``{hash}``.

    Args:
        conn: A DB-API connection (``sqlite3`` / ``psycopg``).
        data_transform: Optional cross-version data hook, run after new
            columns are added and before retired ones are dropped. Should
            be idempotent.

    Returns:
        ``True``; a database error raises and rolls the migration back.
    """
    return migrate(conn, SPEC, {name}_dao, data_transform)
