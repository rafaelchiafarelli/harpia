def test_crudl_round_trip(tmp_path: Path) -> None:
    # a file, not :memory: (the pool refuses it; same database either way)
    conn = sqlite3.connect(str(tmp_path / "db.sqlite"))
    try:
        testing.create_tables(conn, {name}_dao)
        dao = {name}_dao(conn)
        first = testing.sample({name}, "a", pk=1, id_base=1000)
        second = testing.sample({name}, "a", pk=2, id_base=2000)
        assert dao.create(first) and dao.create(second)
        got = {name}()
        assert dao.read(1, got)
        assert (testing.persisted_view({name}_dao, got)
                == testing.persisted_view({name}_dao, first))
        assert not dao.read(99, {name}())
        assert ([testing.persisted_view({name}_dao, m) for m in dao.list()]
                == [testing.persisted_view({name}_dao, m) for m in (first, second)])
        assert len(dao.list(1, 1)) == 1
        changed = testing.sample({name}, "b", pk=1, id_base=1000)
        assert dao.update(changed)
        got = {name}()
        assert dao.read(1, got)
        assert (testing.persisted_view({name}_dao, got)
                == testing.persisted_view({name}_dao, changed))
        assert dao.remove(1)
        assert not dao.read(1, {name}())
        assert len(dao.list()) == 1
    finally:
        conn.close()


def test_access_modifiers(tmp_path: Path) -> None:
    conn = sqlite3.connect(str(tmp_path / "pk.sqlite"))
    try:
        testing.create_tables(conn, {name}_dao)
        dao = {name}_dao(conn)
        assert dao.create(testing.sample({name}, "a", pk=1))
        # the primary key is unique: a second row with the same key is refused
        with pytest.raises(sqlite3.IntegrityError):
            dao.create(testing.sample({name}, "b", pk=1, id_base=5000))
    finally:
        conn.close()
