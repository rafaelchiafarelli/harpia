def _pool(tmp_path: Path, tables: bool = True) -> ConnectionPool:
    pool = sqlite_pool(str(tmp_path / ("app.db" if tables else "empty.db")))
    if tables:
        with pool.borrow() as conn:
            testing.create_tables(conn, {name}_dao)
    return pool


def test_slower() -> None:
    def slow(req: Request) -> Response:
        time.sleep(0.15)  # a slow application
        return text(200, "ok")
    router = Router()
    router.add("GET", "/slow", slow)
    server = Server(router)
    server.start()
    try:  # a generous timeout tolerates the slow response
        assert testing.request(server.port, "GET", "/slow", timeout=5.0) == (200, "ok")
    finally:
        server.stop()
    started = time.monotonic()
    with pytest.raises(OSError):  # a dead endpoint fails cleanly, bounded
        testing.request(1, "GET", "/nope", timeout=1.0)
    assert time.monotonic() - started < 3.0


def test_non_parseable(tmp_path: Path) -> None:
    msg = {name}()
    assert not from_json("{{ not valid json", msg)
    assert not is_valid_json("definitely not json", msg)
    assert not from_xml("<unclosed", msg)
    with testing.serve(_pool(tmp_path), rest=[rest.register], soap=[soap.register]) as port:
        # malformed SOAP is refused at parse (400), before any gate
        assert testing.request(port, "POST", "/soap/{name}", "<not soap", XML)[0] == 400
        assert testing.request(port, "POST", "/api/v1/{name}", "{{ not json",
                               {{"Content-Type": "application/json", **CRED}})[0] == {bad_json}


