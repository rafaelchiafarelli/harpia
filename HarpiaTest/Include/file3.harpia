// canonical example of the optional/required/map<K,V>-x3/pagination
// modifier combination (previously duplicated near-verbatim by pope/king/
// queenBee, folded away here as pure redundancy -- see
// Initiatives/feature-examples/histories/track-ex-feature-examples.md,
// Session EX.1).
message queen{

    int var;
    optional int val;
    required pagination[12] map<string,string> a;
    required map<string,int> b;
    required map<int,string> c;
    pagination[12] int vari;
};

// PUSH only, no PULL EVENT or STREAM, exercises the runtime per-instance
// origin id many-to-one ZMQ senders use.
push message courier{
    string payload;
};

// table-less target for a repeated composed field (Database.model
// RepeatedComposedField), a child table with one column per each parcel
// own flattened fields, one row per repetition.
message parcel{
    string label;
    int weight;
};

// exercises repeteable of a table-less composed type.
message shipment{
    string tag;
    repeteable parcel cargo;
}shipment_table;

// table-less leaf, and a table-less message nesting ANOTHER table-less
// composed field (route.start), exercising the recursive embed flatten.
message waypoint{
    string city;
    int elevation;
};

message route{
    waypoint start;
    string label;
};

// exercises a singular composed field whose own sub-field is itself
// composed to a table-less message (2-level embed flatten).
message journey{
    route path;
    string vessel;
}journey_table;

// table-bearing leaf reached from INSIDE an embedded message below --
// exercises a composed field nested inside a table-less embed whose own
// target owns a table (an FK found inside an embed).
message crew{
    string name;
}crew_table;

// table-less; embeds a plain scalar sub-field (the already-working case)
// alongside a composed sub-field whose own target owns a table (the gap).
message crew_quarters{
    string label;
    crew skipper;
};

message outpost{
    string commander;
    crew_quarters berth;
}outpost_table;

// exercises non-additive migration RENAME (this field replaces an older
// column that used to be named handle).
message beacon_log{
    renamed_from[handle] string label;
    int strength;
}beacon_log_table;

// exercises the Foundation F2 phi field modifier -- per-field, composes
// with other modifiers, and mixes phi and non-phi fields in one message
// (design-rules doc Rule 0). checked-in canonical fixture for downstream
// compliance tracks (Track A DB encryption and audit-on-access, Track F
// redaction, Track Q FHIR facade) to build integration tests against.
message patient_vitals{
    phi string patient_id;
    phi required float heart_rate;
    optional string device_note;
}patient_vitals_table;

// exercises the critical message-type modifier (sensitive-data design
// rules doc Rule 0, criticality axis) -- composed with the event transport
// kind, and carrying a phi field too, since the two axes are independent
// (a patient-specific alarm is both high-criticality and high-confidentiality).
// checked-in canonical fixture for the delivery-guarantee machinery (Phase 3
// of sensitive-data-implementation-roadmap.md) to build its send/receive
// integration test against. Also carries dds (dds-transport epic) -- a
// patient alarm is exactly what crosses an ASTM F2761 / OpenICE bus -- so it
// is the critical-QoS-profile fixture for the DDS adapter (RELIABLE +
// KEEP_ALL) alongside vitals_publication for the non-critical profile.
critical event dds message alarm_event{
    phi string patient_id;
    string alarm_type;
    int severity;
}alarm_event_table;

// fully phi fixture for Track F redaction (F.3 uniform placeholder, F.5
// round trip). every field is phi and the types span string, int and
// float so the redacted placeholder is exercised across all of them, not
// just strings. table less on purpose to keep the golden blast radius to
// the serialization adapters only.
message lab_result{
    phi string subject_ref;
    phi string analyte_code;
    phi int value_scaled;
    phi float reference_high;
};

// exercises Track H.1, repeated-scalar child-table schema migration.
// add (a new child table for a new repeated field), rename (the repeated
// field carries renamed from, so its child table is renamed rather than
// left orphaned beside an empty new one), drop (a repeated field removed
// between versions leaves an orphan child table that migrate must reap),
// and retype (the element type changed, so the child table value column
// is brought to the current type). Mirrors the main-table
// rename add drop retype machinery beacon_log exercises for plain columns.
// table-less target for telemetry.traces, a repeated-composed field
// (Track H.3). its own fields (kind, weight) become the data columns of
// the telemetry_table__traces child table, one row per repetition.
message trace_row{
    string kind;
    int weight;
};

message telemetry{
    string label;
    repeteable int samples;
    renamed_from[old_notes] repeteable string notes;
    map<string,int> gauges;
    renamed_from[old_flags] map<int,string> flags;
    renamed_from[old_traces] repeteable trace_row traces;
}telemetry_table;

// exercises the dds transport-selection modifier (dds-transport epic,
// task 1). dds marks a message for publish onto / subscribe from an ASTM
// F2761 / OpenICE-class DDS bus, independent of whether the same message is
// also reachable via ZMQ or gRPC. flag only in the front end -- a dds
// message emits byte-identical .proto to the same message without it, the
// same guarantee phi and critical already hold. composed with phi on one
// field so the dds-transport epic phi-over-DDS audit task (task 4) has a
// checked-in fixture. table-less on purpose to keep the golden blast radius
// off the DB adapters.
dds message vitals_publication{
    phi string patient_ref;
    float spo2;
    int pulse_rate;
};
