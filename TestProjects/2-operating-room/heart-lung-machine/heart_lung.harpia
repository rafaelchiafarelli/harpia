import "common.harpia";

// Heart-Lung Machine -- takes over pumping and oxygenation during open
// heart surgery.

// Extracorporeal perfusion metrics streamed to the network.
stream push event message perfusion_metrics {
    required float blood_flow_l_min;
    required float blood_temperature_c;
    required float oxygenation_percent;
    required float system_pressure_mmhg;
} perfusion_metrics_table;

// System safety pressure alarm.
push event message perfusion_safety_alarm {
    required int alarm_code;
    required float pressure_mmhg;
} perfusion_safety_alarm_table;

// Surgical procedural timestamp marker pulled from the network.
pull message procedure_marker {
    required int epoch_millis;
    string phase_label;
};
