import "common.harpia";

// Endoscopy Video Tower -- light source, video processing and display for
// an inserted scope. Inbound surgeon login and patient tags arrive via
// common.harpia (clinician_identity, patient_demographics).

// Live video stream status and light source output.
stream push message video_stream_status {
    required int fps;
    string resolution_label;
    required float light_source_output_percent;
} video_stream_status_table;

// Captured static surgical snapshot.
push event message surgical_snapshot {
    string snapshot_id;
    string case_id;
    string caption;
} surgical_snapshot_table;

// Light source performance statistics.
push message light_source_stats {
    required float lamp_hours;
    required float output_percent;
    required float temperature_c;
} light_source_stats_table;
