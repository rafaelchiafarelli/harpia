import "common.harpia";

// Ward Information Integrator -- OR. Theatre local edge hub. Uplink messages to
// the Hospital Management System are push. Downlink reference data the hub
// caches for local redistribution arrives via common.harpia plus the case
// validation cache below.

enum integrator_link_state {
    unknown = 0;
    online;
    degraded;
    store_and_forward;
}

// Aggregated OR telemetry sample forwarded to the HMS.
stream push event message ward_telemetry_batch {
    required string ward_id;
    required string device_id;
    required string metric_name;
    required float metric_value;
    required int sample_epoch_millis;
} ward_telemetry_batch_table;

// Aggregated numerical alarm forwarded to the HMS.
push event message ward_alarm_relay {
    required string ward_id;
    required string device_id;
    required int alarm_code;
    required int active;
} ward_alarm_relay_table;

// Per device calibration and audit log line forwarded to the HMS.
push event message ward_audit_relay {
    required string source_id;
    required string category;
    required string detail;
    required int epoch_millis;
} ward_audit_relay_table;

// Store and forward replay summary sent when the HMS link is restored.
push event message store_forward_replay {
    required string ward_id;
    required int first_epoch_millis;
    required int last_epoch_millis;
    required int record_count;
} store_forward_replay_table;

// Current uplink state of this hub.
push event message integrator_link_status {
    required string ward_id;
    integrator_link_state state;
    required int buffered_records;
} integrator_link_status_table;

// Surgical case validation record cached from the HMS for redistribution to
// OR devices.
pull event message case_validation_cache {
    required string case_id;
    phi required string patient_id;
    required string surgeon_login_id;
    required int checklist_complete;
} case_validation_cache_table;
