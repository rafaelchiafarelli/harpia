import "common.harpia";

// Electronic Hospital Bed -- motorised platform for positioning, weighing
// and bed exit detection.

// Bed position, side rail flags and integrated scale weight, streamed.
stream push event message bed_status {
    required float elevation_angle_deg;
    required int left_rail_up;
    required int right_rail_up;
    required float scale_weight_kg;
} bed_status_table;

// Active patient bed exit alert.
push event message bed_exit_alert {
    phi string patient_id;
    required int active;
} bed_exit_alert_table;

// Remote bed lock reset command from the nurses station.
pull message bed_lock_reset {
    required string device_id;
    required string requested_by;
};
