import "common.harpia";

// Feeding Pump -- delivers measured liquid nutrition into a digestive
// tube.

enum feeding_alert_kind {
    none = 0;
    occlusion;
    tube_block;
}

// Live feeding state streamed to the network.
stream push event message feeding_status {
    required float feed_rate_ml_h;
    required float total_volume_delivered_ml;
} feeding_status_table;

// Pump occlusion or tube block alert.
push event message feeding_block_alert {
    feeding_alert_kind kind;
    required int active;
} feeding_block_alert_table;

// Scheduled daily nutrition plan pulled from the network.
pull event message nutrition_plan {
    required string plan_id;
    required float target_rate_ml_h;
    int target_volume_ml;
    repeteable string schedule_windows;
} nutrition_plan_table;
