import "common.harpia";

// Mechanical Ventilator -- pumps respiratory gases on a breathing cycle.
// Inbound clock sync arrives via common.harpia (clock_sync).

// Continuous respiratory metrics streamed to the network.
stream push event message ventilation_metrics {
    required float tidal_volume_ml;
    required float airway_pressure_cmh2o;
    required float fio2_percent;
    required float respiration_frequency_bpm;
} ventilation_metrics_table;

// Critical respiratory disconnect alarm.
push event message disconnect_alarm {
    required int alarm_code;
    required int is_disconnected;
} disconnect_alarm_table;

// Target ventilation profile received read only from the network.
pull message ventilation_profile {
    required int target_tidal_volume_ml;
    required float target_fio2_percent;
    int target_rate_bpm;
};
