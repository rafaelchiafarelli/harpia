import "common.harpia";

// Infusion Pump -- controls the delivery rate of IV fluids and drugs.

enum infusion_alert_kind {
    none = 0;
    air_in_line;
    occlusion;
    empty_bag;
}

// Live infusion state streamed to the network.
stream push event message infusion_status {
    required float flow_rate_ml_h;
    required float total_volume_infused_ml;
    string drug_library_name;
} infusion_status_table;

// Safety alert raised by the pump.
push event message infusion_safety_alert {
    infusion_alert_kind kind;
    required int active;
} infusion_safety_alert_table;

// Verified electronic prescription pulled from the order system.
pull event message electronic_prescription {
    required string prescription_id;
    required string drug_name;
    required float dose_rate_ml_h;
    string ordering_physician;
} electronic_prescription_table;
