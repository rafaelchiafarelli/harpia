import "common.harpia";

// Multiparameter Patient Monitor -- centralises and streams continuous
// vital signs at the bedside. Inbound patient demographics arrive via
// common.harpia (patient_demographics).

// Live vital sign metrics streamed continuously to the central station.
stream push event message vital_signs {
    phi required string patient_id;
    required float heart_rate_bpm;
    required float spo2_percent;
    required float respiration_rate_bpm;
    required float bp_systolic_mmhg;
    required float bp_diastolic_mmhg;
} vital_signs_table;

// Numerical alarm plus the active warning flags shown on the display.
push event message monitor_alarm {
    phi required string patient_id;
    required int alarm_code;
    required int severity;
    repeteable string warning_flags;
} monitor_alarm_table;
