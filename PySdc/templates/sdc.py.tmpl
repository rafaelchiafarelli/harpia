"""WS-Discovery participant descriptor for ``{name}``.

Generated by harpia (python target), the Python side of the C++
``sdc/{name}_{hash}_sdc.h``. Do not edit. Advertises ``{name}``'s SOAP
endpoint (``POST <soap_url>/{name}``) for zero-config discovery by an
SDC/DPWS-aware client -- additive, the endpoint itself is unchanged::

    responder = Responder()
    register_{name}_wsdiscovery(responder, "http://host:8080/soap")
    responder.start()
"""
from harpia_runtime.wsdiscovery import Endpoint, Responder

#: stable RFC-4122 v5 endpoint reference (project + message + schema hash)
ENDPOINT_REFERENCE = {epr_lit}
#: the fixed generic DPWS device type
DEVICE_TYPE = {device_type_lit}
#: the Harpia-namespaced per-project scope
SCOPE = {scope_lit}


def {name}_wsdiscovery_endpoint(soap_url: str) -> Endpoint:
    """The advertised endpoint; ``soap_url`` is the deployment's SOAP base
    URL (e.g. ``"http://host:8080/soap"``)."""
    return Endpoint(ENDPOINT_REFERENCE, [DEVICE_TYPE], [SCOPE], soap_url + "/{name}")


def register_{name}_wsdiscovery(responder: Responder, soap_url: str) -> None:
    """Register ``{name}``'s endpoint (before ``responder.start()``)."""
    responder.add({name}_wsdiscovery_endpoint(soap_url))
