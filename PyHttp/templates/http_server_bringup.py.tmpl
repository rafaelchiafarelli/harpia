"""The project's HTTP server: every REST binding (and every SOAP endpoint)
on one threaded server.

Generated by harpia (python target), the Python side of the C++
``http/http_server_bringup.h``. Do not edit::

    pool = sqlite_pool("app.db")
    server = HttpServer(pool, port=8080)
    server.start()
    ...
    server.stop()

When some message is RBAC-gated the server also issues bearer session tokens
(``POST <rest_base>/session`` / ``POST <soap_base>/session``, see
:func:`harpia_runtime.rbac_gates.register_session_routes`).
"""
{imports}
from harpia_runtime.db.pool import ConnectionPool
from harpia_runtime.http.router import Router, Server{session_import}
from harpia_runtime.tls import MtlsFiles, http_server_context

#: every message with REST routes
REST_MESSAGES = {rest_names}
#: transport_hardening_required(compliance), evaluated at generation time:
#: when true the server only speaks mTLS (incomplete files → SecurityRefused)
HARDENING_REQUIRED = {hardening}
{mode_consts}

class HttpServer:
    """REST routes under ``rest_base`` (and SOAP under ``soap_base``) on one
    :class:`~harpia_runtime.http.router.Server`; each request borrows its own
    connection from ``pool``."""

    def __init__(self, pool: ConnectionPool, host: str = "127.0.0.1", port: int = 0,
                 rest_base: str = "", soap_base: str = "/soap",
                 mtls: MtlsFiles | None = None) -> None:
        if rest_base == soap_base:
            raise ValueError("rest_base and soap_base must differ")
        self.router = Router()
{registrations}
        tls = http_server_context({tls_args})
        self._server = Server(self.router, host, port, tls)

    @property
    def port(self) -> int:
        """The bound port."""
        return self._server.port

    def start(self) -> None:
        """Serve on a background thread."""
        self._server.start()

    def stop(self) -> None:
        """Stop serving."""
        self._server.stop()
