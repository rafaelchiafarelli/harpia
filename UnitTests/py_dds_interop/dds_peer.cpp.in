// python-target / py-dds -- C++ DDS peer for test_py_dds.py (@HASH@ is
// substituted by the test).
//
//   dds_peer pub <alarm|vitals> <topic> <n> [certs]  wait for a match,
//                                                    publish 1..n
//   dds_peer sub <alarm|vitals> <topic> <n> [certs]  print READY, then GOT
//                                                    lines until n or 20 s
// With [certs] (a dds_security_provision.sh output dir) the participant is
// harpia::dds_security::secured_participant; domain from $HARPIA_DDS_DOMAIN
// (default 0).
//   dds_peer xml - - 0 <certs>   print the Cyclone <Security> config XML
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <thread>

#include "dds/dds.hpp"
#include "dds/harpia_dds_security.h"
#include "dds/alarm_event_@HASH@_dds.h"
#include "dds/vitals_publication_@HASH@_dds.h"

using namespace harpia::dds_transport;
using clk = std::chrono::steady_clock;

template <typename Pub, typename Make>
static int publish(Pub& pub, int n, Make make) {
  const auto deadline = clk::now() + std::chrono::seconds(20);
  while (pub.matched_subscribers() == 0 && clk::now() < deadline)
    std::this_thread::sleep_for(std::chrono::milliseconds(20));
  if (pub.matched_subscribers() == 0) { std::printf("NOMATCH\n"); return 1; }
  std::this_thread::sleep_for(std::chrono::milliseconds(300));
  for (int i = 1; i <= n; ++i) {
    pub.publish(make(i));
    std::this_thread::sleep_for(std::chrono::milliseconds(20));
  }
  std::this_thread::sleep_for(std::chrono::milliseconds(1000));
  std::printf("PUB_DONE\n");
  return 0;
}

template <typename Sub, typename Msg, typename Show>
static int subscribe(Sub& sub, int n, Show show) {
  std::printf("READY\n");
  std::fflush(stdout);
  int got = 0;
  const auto deadline = clk::now() + std::chrono::seconds(20);
  while (got < n && clk::now() < deadline) {
    Msg m;
    if (sub.receive(&m)) { show(m); ++got; std::fflush(stdout); }
    else std::this_thread::sleep_for(std::chrono::milliseconds(5));
  }
  std::printf("SUB_DONE %d\n", got);
  return 0;
}

static harpia::dds_security::SecurityFiles files_from(const std::string& c) {
  harpia::dds_security::SecurityFiles f;
  f.identity_ca = c + "/identity_ca.pem";
  f.identity_certificate = c + "/identity_certificate.pem";
  f.private_key = c + "/private_key.pem";
  f.permissions_ca = c + "/permissions_ca.pem";
  f.governance = c + "/governance.p7s";
  f.permissions = c + "/permissions.p7s";
  return f;
}

static ::dds::domain::DomainParticipant participant(int argc, char** argv) {
  const char* d = std::getenv("HARPIA_DDS_DOMAIN");
  const uint32_t domain = d ? static_cast<uint32_t>(std::atoi(d)) : 0;
  if (argc < 6) return ::dds::domain::DomainParticipant(domain);
  return harpia::dds_security::secured_participant(domain, files_from(argv[5]));
}

int main(int argc, char** argv) {
  if (argc != 5 && argc != 6) return 2;
  const std::string mode = argv[1], type = argv[2], topic = argv[3];
  const int n = std::atoi(argv[4]);
  if (mode == "xml") {
    std::printf("%s", harpia::dds_security::detail::security_config_xml(
        files_from(argv[5]), "fips").c_str());
    return 0;
  }
  auto dp = participant(argc, argv);
  if (type == "alarm") {
    if (mode == "pub") {
      alarm_event_publisher p(dp, topic);
      return publish(p, n, [](int i) {
        ::alarm_event a; a.set_patient_id("p-cpp"); a.set_alarm_type("apnea");
        a.set_severity(i); return a; });
    }
    alarm_event_subscriber s(dp, topic);
    return subscribe<alarm_event_subscriber, ::alarm_event>(s, n, [](const ::alarm_event& a) {
      std::printf("GOT %d %s %s\n", a.severity(), a.patient_id().c_str(),
                  a.alarm_type().c_str()); });
  }
  if (mode == "pub") {
    vitals_publication_publisher p(dp, topic);
    return publish(p, n, [](int i) {
      ::vitals_publication v; v.set_patient_ref("p-cpp"); v.set_spo2(97.5f);
      v.set_pulse_rate(i); return v; });
  }
  vitals_publication_subscriber s(dp, topic);
  return subscribe<vitals_publication_subscriber, ::vitals_publication>(
      s, n, [](const ::vitals_publication& v) {
        std::printf("GOT %d %s %.1f\n", v.pulse_rate(), v.patient_ref().c_str(), v.spo2()); });
}
