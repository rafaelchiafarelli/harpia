<?xml version="1.0" encoding="UTF-8"?>
<!-- harpia DDS-Security permissions document (dds-transport epic, task 3).
     RENDERED per project by DdsAdapter: the <allow_rule> topic lists below
     are exactly this schema's `dds` message topic names. A deployment
     replaces the subject / validity / grant set with its own and S/MIME-
     signs the result with its permissions CA; the demo's
     Assets/cmake/dds_security_provision.sh substitutes the throwaway
     identity's real subject for the %HARPIA_SUBJECT_NAME% sentinel and
     signs with a throwaway CA.

     One grant, allowing publish + subscribe on this schema's `dds` topics
     and nothing else -- default-deny (master plan §0a). -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="harpia_dds_participant">
      <subject_name>%HARPIA_SUBJECT_NAME%</subject_name>
      <validity>
        <not_before>2024-01-01T00:00:00</not_before>
        <not_after>2124-01-01T00:00:00</not_after>
      </validity>
      <allow_rule>
        <domains>
          <id_range>
            <min>0</min>
            <max>230</max>
          </id_range>
        </domains>
        <publish>
          <topics>
            <topic>alarm_event</topic>
            <topic>vitals_publication</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>alarm_event</topic>
            <topic>vitals_publication</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
